# CodeVia — AI Engineering Agent Platform
# Copy to .env and fill in. Secrets are ALWAYS read from environment/secret
# manager; they are NEVER committed to Git and never stored in export files.

# ---- Core ----
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATABASE_PATH=./data/codevia.db

# ---- AI Model Providers (Secret References) ----
# Only set a key if you want to use that provider. Without keys the platform
# runs in fully-offline "Mock AI" mode (dev/test/Simulation Mode).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- GitHub (GitHub App + OAuth) ----
# The platform uses the real REST adapter in production when GITHUB_ENABLED=true
# and a token is set. Otherwise it falls back to a mock for local dev/test.
# NOTE: GITHUB_TOKEN is the only API token (PAT / OAuth user token / App
# installation token). GITHUB_CLIENT_SECRET is the OAuth app secret and is NOT
# a token — it is only used for the login code exchange.
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional overrides for the user-login flow (defaults shown):
# GITHUB_OAUTH_SCOPE=repo read:user user:email
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Webhook HMAC secret for /webhooks/github signature validation.
GITHUB_WEBHOOK_SECRET=
GITHUB_ENABLED=false

# ---- Platform auth (GitHub-login sessions) ----
# Signs session cookies/tokens + OAuth state. REQUIRED in production when
# GitHub login is used; ANY random 32+ char string works.
# AUTH_SECRET=
# Set true to reject unauthenticated API calls with 401 (default false = demo
# mode still works locally, UI prompts for GitHub login). Accepted values:
# true/false, 1/0, yes/no, on/off. Only enable it AFTER GitHub login works
# (Client ID + GITHUB_CLIENT_SECRET + AUTH_SECRET), otherwise the platform
# stays in demo mode and logs a warning.
# REQUIRE_AUTH=false

# ---- Telegram Bot ----
# 1. Create a bot with @BotFather and paste its token here.
# 2. Set ENABLE_TELEGRAM=true.
# 3. Point Telegram at a public HTTPS URL so the bot can receive messages.
#    Telegram REJECTS http:// and localhost URLs ("An HTTPS URL must be
#    provided for webhook"). In production set PUBLIC_WEB_BASE_URL to your
#    https://<app>.up.railway.app. For local dev, either use an HTTPS tunnel
#    (ngrok/cloudflared) or set TELEGRAM_WEBHOOK_URL to the tunnel's HTTPS URL
#    explicitly so the platform doesn't use the http://localhost default.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional override for the public webhook URL the bot receives updates on.
# Defaults to PUBLIC_WEB_BASE_URL (or WEB_BASE_URL) + /integrations/telegram/webhook.
# TELEGRAM_WEBHOOK_URL=https://your-tunnel.example.com/integrations/telegram/webhook
ENABLE_TELEGRAM=false

# ---- Platform behavior ----
ENABLE_SIMULATION_MODE=true
MOCK_AI_DEFAULT=true

# ---- Web UI ----
WEB_BASE_URL=http://localhost:8080
# Set to the public Railway URL in production for absolute links/notifications.
# PUBLIC_WEB_BASE_URL=https://your-app.up.railway.app
