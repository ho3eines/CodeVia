# CodeVia — AI Engineering Agent Platform
# Copy to .env and fill in. Secrets are ALWAYS read from environment/secret
# manager; they are NEVER committed to Git and never stored in export files.

# ---- Core ----
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATABASE_PATH=./data/codevia.db

# ---- AI Model Providers (Secret References) ----
# Only set a key if you want to use that provider. Without keys the platform
# runs in fully-offline "Mock AI" mode (dev/test/Simulation Mode).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- GitHub (GitHub App + OAuth) ----
# The platform uses the real REST adapter in production when GITHUB_ENABLED=true
# and a token is set. Otherwise it falls back to a mock for local dev/test.
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Webhook HMAC secret for /webhooks/github signature validation.
GITHUB_WEBHOOK_SECRET=
GITHUB_ENABLED=false

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ENABLE_TELEGRAM=false

# ---- Platform behavior ----
ENABLE_SIMULATION_MODE=true
MOCK_AI_DEFAULT=true

# ---- Web UI ----
WEB_BASE_URL=http://localhost:8080
# Set to the public Railway URL in production for absolute links/notifications.
# PUBLIC_WEB_BASE_URL=https://your-app.up.railway.app
