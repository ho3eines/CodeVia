+      for (const part of chunk(checkout, 80)) {
+        await this.gitChecked(
+          ["restore", `--source=${newSha}`, "--staged", "--worktree", "--", ...part],
+          repoDir,
+          `working-tree sync failed for branch "${branch}"`,
