+  private validateRepoRef(repo: GithubRepoRef): void {
+    const ok = (s: unknown): s is string =>
+      typeof s === "string" && /^[A-Za-z0-9][A-Za-z0-9._-]{0,150}$/.test(s) && s !== "." && s !== ".." && !s.endsWith(".lock");
